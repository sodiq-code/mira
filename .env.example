# Creditcoin CC3 Testnet JSON-RPC endpoint (public default works for reads)
CREDITCOIN_RPC_URL=https://rpc.cc3-testnet.creditcoin.network

# Ethereum Sepolia JSON-RPC endpoint (public default works for reads)
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Gluwa-hosted Attestcoin proof builder service
CREDITCOIN_PROOF_BUILDER_URL=https://prover.cc3-testnet.creditcoin.network

# Funded CC3 Testnet wallet key — required for on-chain operations
# (originate loans, mark repaid, emit TransactionVerified events).
# This is the WORKER (hot) key. It can call originate, markRepaid,
# markDefaulted (after due block) — but NOT forceMarkDefaulted or
# lockToProductionMode (those are governance-only).
CREDITCOIN_PRIVATE_KEY=0x...

# Governance (cold) key — required for the demo force-default endpoint
# (/api/demo/trigger-default calls Loan.forceMarkDefaulted, which is
# governance-only). In production, defaults flow through the worker's
# markDefaulted() after the due block; this key is only needed for the
# demo's instant-default convenience. MUST be different from
# CREDITCOIN_PRIVATE_KEY. NEVER commit the real key — keep it in .env only.
GOVERNANCE_PRIVATE_KEY=0x...

# Role separation (required for contracts:deploy):
# WORKER_ADDRESS  = hot operational key (originates/repays loans, lives on the server)
# GOVERNANCE_ADDRESS = cold/multisig key (owns bounds, pause, force-default, worker rotation)
# These MUST be different addresses. deploy.ts refuses to run if missing or equal.
WORKER_ADDRESS=0x...
GOVERNANCE_ADDRESS=0x...

# Deployed contract addresses on CC3 Testnet
# (deployed by `bun run contracts:deploy`, or redeploy just the Loan with
#  `bun run contracts:redeploy-loan` — the addresses below are the live deployment)
TOKEN_ADDRESS=0x99305c7AdB03A1A7E753d328b3724C9b0e0aD845
POLICY_ADDRESS=0xDae48F95976ED12903989b66897197094e4aba8e
LOAN_ADDRESS=0xb66E51b53E89c4DF8fFF3AEB9888108B3D6B01b3
AGENT_REPUTATION_ADDRESS=0x09328398FC0D4a78b22fC6470412Ca13ac5A21f0
BORROWER_REPUTATION_ADDRESS=0x90B19D3dF8B8c9cC8d493954C02448d35CBedC84
LIQUIDITY_POOL_ADDRESS=0xf0F43bc997eC44e26492C0c3E8B2e05e22f205EB

# Optional: enable real Attestcoin credit verification in /api/credit/check
# (calls runCreditCheck: Sepolia scan → proof → BlockProver verifySingle).
# Unset = preset/synthetic demo path (the default).
# MIRA_REAL_CREDIT_CHECK=1

# Optional: hard timeout (ms) for the real credit-check path before falling
# back to synthetic data. Default 40000.
# MIRA_REAL_CHECK_TIMEOUT_MS=40000

# Optional: pin the Sepolia source chain key on Creditcoin (skips auto-detection)
# SOURCE_CHAIN_KEY=1

# Optional: validate a specific Sepolia transaction hash
# SOURCE_CHAIN_TXN_HASH=0x...

# Optional: force-skip the on-chain emit step even when a key is present
# SKIP_ONCHAIN_EMIT=1

# Local database (SQLite) for off-chain caches
DATABASE_URL=file:/home/z/my-project/db/custom.db
