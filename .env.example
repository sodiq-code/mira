# Creditcoin CC3 Testnet JSON-RPC endpoint (public default works for reads)
CREDITCOIN_RPC_URL=https://rpc.cc3-testnet.creditcoin.network

# Ethereum Sepolia JSON-RPC endpoint (public default works for reads)
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Gluwa-hosted Attestcoin proof builder service
CREDITCOIN_PROOF_BUILDER_URL=https://prover.cc3-testnet.creditcoin.network

# Optional: pin the Sepolia source chain key on Creditcoin (skips auto-detection)
# SOURCE_CHAIN_KEY=1

# Optional: validate a specific Sepolia transaction hash
# SOURCE_CHAIN_TXN_HASH=0x...

# Optional: funded CC3 Testnet wallet key — enables on-chain emit (writability)
# Leave unset to run read-only verification (no gas required)
# CREDITCOIN_PRIVATE_KEY=0x...

# Optional: force-skip the on-chain emit step even when a key is present
# SKIP_ONCHAIN_EMIT=1

# Local database (SQLite) for off-chain caches
DATABASE_URL=file:/home/z/my-project/db/custom.db
